# MongoDB connection string (required)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname

# JWT Secret — MUST be a long random string in production (required)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-very-long-random-secret-here

# One-time secret to protect the create-admin endpoint (required to create admin accounts)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# After creating your admin account, rotate or remove this value.
ADMIN_SECRET=your-one-time-admin-creation-secret

# Your Netlify site URL — used for CORS (Netlify sets this automatically in production)
# For local dev: http://localhost:5173
# In Netlify: set automatically as URL env var, no action needed
URL=https://your-site.netlify.app

# For local dev: http://localhost:5173
# In Netlify: set automatically as URL env var, no action needed
URL=https://your-site.netlify.app
